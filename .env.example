# ---------------------------------------------------------------------------
# CafeCaption — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (local) and add the same values in
# Vercel → Settings → Environment Variables, then redeploy.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# 1) REQUIRED — caption generation -------------------------------------------------
# Get a free key at https://aistudio.google.com/app/apikey
#
# ⚠️  This key is read ONLY by app/api/generate/route.ts (guarded with
#     `import "server-only"`). It is NOT prefixed with NEXT_PUBLIC_, so Next.js
#     never ships it to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — override the Gemini model (defaults to gemini-2.5-flash).
# The thinking budget is disabled for 2.5 models automatically: reasoning
# tokens share the output budget and can starve the JSON reply.
# GEMINI_MODEL=gemini-2.5-flash

# Optional — the model used for the last retry if the primary is overloaded
# or unavailable (defaults to gemini-3.5-flash-lite).
# It MUST be multimodal: photo uploads go through the exact same ladder.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
#
# Retired ids to avoid: gemini-1.5-flash (shut down Sep 2025) and
# gemini-2.0-flash (shut down 2026) — both answer 404.
#
# Photo upload has no separate model. Images are downscaled in the browser
# (long edge 1024px, JPEG under 1 MB) and sent as an inlineData part.


# 2) OPTIONAL — public site URL ---------------------------------------------------
# Used for canonical URLs, sitemap.xml, robots.txt and the Open Graph image.
# Example: https://cafecaption.in
NEXT_PUBLIC_SITE_URL=


# 3) OPTIONAL — analytics (PostHog) ------------------------------------------------
# Free with the GitHub Student Pack. Create a project at posthog.com, then paste
# its project API key. Leave the key blank to disable analytics: every `track()`
# call becomes a console log in development and a no-op in production.
NEXT_PUBLIC_POSTHOG_KEY=
# Use https://eu.i.posthog.com if your PostHog project lives in the EU region.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# 4) OPTIONAL — lead capture (Supabase) -------------------------------------------
# Run supabase/schema.sql in your project, then copy the URL + anon/publishable
# key from Supabase → Project Settings → API.
#
# Without these the contact form still works: the visitor is offered a one-tap
# WhatsApp handoff, but enquiries are not stored.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_anon_or_publishable_key
# SUPABASE_LEADS_TABLE=leads


# 5) OPTIONAL — photo → 3D models (free, but needs two accounts) ------------------
# Generation runs on a Hugging Face Space with ZeroGPU hardware. Duplicate any
# open image-to-3D Space (TripoSR / SF3D / TRELLIS) to your own account, then put
# its URL here. Free accounts get 5 GPU-minutes a day across the whole account,
# so expect a handful of dish models a day and an honest "busy" message after
# that. Leave THREED_SPACE_URL blank to switch generation off — the studio says
# so instead of pretending.
# THREED_SPACE_URL=https://your-user-dish-3d.hf.space
# THREED_SPACE_API=/predict
# HF_TOKEN=hf_...                  # optional; a free token raises your GPU quota
# THREED_PROVIDER_NAME=triposr     # the credit shown beside the model

# Models are stored on Cloudflare R2 (free tier: 10 GB, no egress fees). Create
# a bucket + an API token with object read & write, then expose the bucket
# publicly (r2.dev subdomain or a custom domain) for R2_PUBLIC_URL.
# Without these the route refuses before spending any GPU time.
# R2_ACCOUNT_ID=
# R2_BUCKET=dish-models
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Operator only: reveal plain GLB / poster / credit fields in the dish studio.
# Never set this on a café's deployment — owners should never see a file format.
# NEXT_PUBLIC_DISH_MANUAL_MODEL=1
