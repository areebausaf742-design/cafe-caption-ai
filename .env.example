# ---------------------------------------------------------------------------
# CafeCaption — every environment variable the app reads
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local work, and add the same values in
# Vercel → Settings → Environment Variables (then redeploy — Next inlines
# `NEXT_PUBLIC_*` at build time, so a changed value needs a new build).
#
#   cp .env.example .env.local
#
# Nothing here is required to *run* the site: every integration degrades to a
# documented, honest message instead of a crash. The one exception is
# GEMINI_API_KEY — without it the studio can't generate anything.
# ---------------------------------------------------------------------------


# 1) REQUIRED — caption / menu generation -----------------------------------
# Free key: https://aistudio.google.com/app/apikey
# Read only by server routes (every route that touches it imports "server-only").
# Never prefixed NEXT_PUBLIC_, so it is never shipped to the browser.
GEMINI_API_KEY=

# Optional — the model ladder. Defaults: gemini-2.5-flash → gemini-2.5-flash-lite
# → gemini-2.5-pro. Leave blank unless Google retires an id; check the live list
# before a launch (see lib/gemini-config.ts for the curl command):
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# GEMINI_LAST_RESORT_MODEL=gemini-2.5-pro

# Optional — a regional or proxied endpoint. Leave blank for Google's default.
# GEMINI_BASE_URL=

# Model ids are a moving target: gemini-1.5-flash (shut down 2025) and
# gemini-2.0-flash (shut down 2026) both answer 404, which the route reports as
# "no usable model" rather than an empty caption.


# 2) REQUIRED IN PRODUCTION — the site's own URL ----------------------------
# Used for canonical URLs, sitemap.xml, robots.txt, the Open Graph image and the
# demo-menu QR code. Vercel exposes a deployment URL automatically, so this is
# only needed when the site lives on a custom domain.
# Example: https://cafecaption.in
NEXT_PUBLIC_SITE_URL=


# 3) OPTIONAL — analytics (PostHog) -----------------------------------------
# Leave the key blank to disable analytics: track() becomes a console log in
# development and a no-op in production.
NEXT_PUBLIC_POSTHOG_KEY=
# https://eu.i.posthog.com for an EU-region project.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# 4) OPTIONAL — rate limiting (Upstash Redis) -------------------------------
# Without these the limiter falls back to an in-memory map, which is per-instance
# and therefore weak on serverless. With them, limits are shared and survive
# cold starts. Create a database at console.upstash.com → REST API.
#
# OPTIONAL. A shared rate limiter is required for the paid routes in production,
# but it does not need a new service: `SUPABASE_SERVICE_ROLE_KEY` above backs it
# with a Postgres counter (see supabase/migrations/20261121100000_rate_limit_store.sql).
# Upstash is a faster alternative, not a prerequisite — set it only if you want
# the counter out of the primary database.
#
# Behaviour when Redis *is* configured but doesn't answer: paid routes fail
# closed (503 RATE_LIMIT_UNAVAILABLE) rather than run unmetered. When neither
# store exists at all in production, they fail closed permanently
# (503 RATE_LIMIT_NOT_CONFIGURED) because a per-instance counter under a limit of
# six is not a limit once a burst can spread across cold starts.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Deliberate override: keep serving on per-instance limits and log a warning on
# every boot saying what that costs. Set it to unblock a deployment, then delete
# it once the shared store is live.
# RATE_LIMIT_ALLOW_MEMORY_LIMITS=1

# Set to 1 only when a proxy you control overwrites x-real-ip / x-forwarded-for
# (nginx, Cloudflare, your own gateway). It is NOT needed on Vercel, where
# x-vercel-forwarded-for is trusted automatically. Without it those headers are
# ignored and every caller shares one bucket — deliberately, because a trusted
# header anyone can send is not a rate limit.
# TRUST_PROXY=1


# 5) OPTIONAL — lead capture + published menus (Supabase) -------------------
# Run supabase/schema.sql in the SQL editor first. Without these the contact
# form still works (visitors get a one-tap WhatsApp handoff) but enquiries are
# not stored, and publishing a menu reports that storage isn't configured.
#
# Reads use the publishable key; WRITES use the service role. `anon` has no
# INSERT privilege on either table, so the service key is the only way a row can
# be created, and it is required: there is no fallback to the publishable key.
# Missing it means 503 STORE_UNAVAILABLE (/api/leads) and 503
# PUBLISHING_DISABLED (/api/menus).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
# SUPABASE_PUBLISHABLE_KEY=          # newer Supabase key, used if ANON_KEY is unset
#
# Server-only. Never prefix it with NEXT_PUBLIC_: it bypasses RLS, so a bundle
# that contained it would hand the whole database to any visitor. Mark it
# "Sensitive" in Vercel. It also refuses to be used if it is byte-identical to
# the publishable key, or if its JWT role claim isn't "service_role".
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_LEADS_TABLE=leads


# 6) OPTIONAL — photo → 3D dish models (needs two free accounts) -------------
# Generation runs on a Hugging Face Space with ZeroGPU. Duplicate an open
# image-to-3D Space (TripoSR / SF3D / TRELLIS) to your own account and put its
# URL here. Free accounts get ~5 GPU-minutes a day, so expect a handful of dish
# models and an honest "busy" message after that. Blank = generation off, and
# the studio says so instead of pretending.
# THREED_SPACE_URL=https://your-user-dish-3d.hf.space
# THREED_SPACE_API=/predict
# HF_TOKEN=hf_...                  # optional; raises the GPU quota. Never exposed to the browser.
# THREED_PROVIDER_NAME=triposr     # the credit shown beside the model

# Models are stored on Cloudflare R2 (free tier: 10 GB, no egress fees). Create a
# bucket and an API token with object read + write, expose the bucket publicly
# (r2.dev subdomain or a custom domain) and set R2_PUBLIC_URL. Without the four
# R2_* values the route refuses before spending any GPU time.
# R2_ACCOUNT_ID=
# R2_BUCKET=dish-models
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# R2_ENDPOINT=                      # only for a non-Cloudflare S3-compatible store

# Comma-separated hosts that menu 3D models and posters may be served from.
# When set, the API rejects any other host — and the CSP narrows img-src/media-src
# to match. R2_PUBLIC_URL is added automatically.
# NEXT_PUBLIC_ASSET_HOSTS=

# Operator only: reveal plain GLB / poster / credit fields in the dish studio.
# Never set this on a café's deployment — owners should never see a file format.
# NEXT_PUBLIC_DISH_MANUAL_MODEL=1
