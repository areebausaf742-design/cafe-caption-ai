# ---------------------------------------------------------------------------
# CafeCaption AI — environment variables
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env.local`
#      cp .env.example .env.local
#
# 2. Paste your Google Gemini API key below.
#    Get a free key at: https://aistudio.google.com/app/apikey
#
#    ⚠️  SECURITY: this key is read ONLY by app/api/generate/route.ts, which is
#    guarded with `import "server-only"`. It is NOT prefixed with NEXT_PUBLIC_,
#    so Next.js will never ship it to the browser bundle.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=your_gemini_api_key_here

# Optional — override the Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional — your public URL. Used for canonical URLs, sitemap.xml, robots.txt
# and the Open Graph image. Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
