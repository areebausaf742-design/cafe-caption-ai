# ---------------------------------------------------------------------------
# CafeCaption AI — environment variables
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env.local`
#      cp .env.example .env.local
#
# 2. Paste your Google Gemini API key below.
#    Get a free key at: https://aistudio.google.com/app/apikey
#
#    ⚠️  SECURITY: this key is only ever read on the server
#    (app/api/generate/route.ts). It is NOT prefixed with NEXT_PUBLIC_,
#    so Next.js will never ship it to the browser.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=your_gemini_api_key_here

# Optional — override the Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
